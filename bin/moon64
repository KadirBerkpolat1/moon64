#!/usr/bin/env bash
# moon64 — run Steam on the 64-bit steamrt64 client with the SLSsteam stack.
#
# Why a switcher rather than just a wrapper: the 32-bit stack — SLSsteam.so,
# library-inject.so, cloud_redirect.so — is ELFCLASS32 and cannot be loaded into
# a 64-bit client. Switching clients is therefore all-or-nothing, and this is
# the single place that decides which side is active (including client markers,
# ~/.config/environment.d/steam-32bit.conf and the Steam desktop entry).
#
#   moon64 on      64-bit client + 64-bit SLSsteam + netsock64 (P2P cert patch)
#   moon64 off     the previous 32-bit stack, byte-for-byte restored
#   moon64 status  what is staged, what is active, which client Steam would start
#   moon64 doctor  whether the 64-bit path can work right now, and why not
#
# `on` and `off` only swap files that install.sh already staged: recovery never
# needs the network. Both commands execute two-phase (stage + verify ELF class
# under $MOON_DIR/staged/, then atomic commit with saved originals and a
# rollback trap).
set -uo pipefail

MOON_DIR="${MOON64_DIR:-$HOME/.local/share/moon64}"
SLS_DIR="$HOME/.local/share/SLSsteam"
CR_DIR="$HOME/.local/share/CloudRedirect"
ENV_CONF="${MOON64_ENV_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/environment.d/steam-32bit.conf}"
ENV_D_DIR="${MOON64_ENV_D_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/environment.d}"
LUMEN_FIX_INSTALLS_DIR="${LUMEN_FIX_INSTALLS_DIR:-$HOME/.local/share/Lumen/fix_installs}"
STAGE_DIR="$MOON_DIR/staged"
STEAM_ROOTS=("$HOME/.steam/steam" "$HOME/.local/share/Steam" "$HOME/.steam/debian-installation")
SLS_WRAPPER="$SLS_DIR/path/steam"
APPS_DIR="${MOON64_APPS_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/applications}"
STEAM_DESKTOP_NAMES=(steam.desktop steam-native.desktop)

c_red=$'\033[38;5;203m'; c_grn=$'\033[38;5;114m'; c_yel=$'\033[38;5;221m'
c_dim=$'\033[2m'; c_nc=$'\033[0m'
if [ ! -t 1 ] || [ -n "${NO_COLOR:-}" ]; then c_red=; c_grn=; c_yel=; c_dim=; c_nc=; fi
ok()   { printf '%s  ok  %s %s\n' "$c_grn" "$c_nc" "$*"; }
warn() { printf '%s warn %s %s\n' "$c_yel" "$c_nc" "$*"; }
bad()  { printf '%s fail %s %s\n' "$c_red" "$c_nc" "$*"; }
dim()  { printf '%s      %s%s\n' "$c_dim" "$*" "$c_nc"; }
die()  { bad "$*"; exit 1; }

elfbits() { [ -f "$1" ] && file -b "$1" 2>/dev/null | sed -n 's/^ELF \(64\|32\)-bit.*/\1/p'; }

require_file_cmd() {
    command -v file >/dev/null 2>&1 || die "file is required"
}

read_steam_pid() {
    local pid_file="$HOME/.steam/steam.pid" pid=""
    [ -f "$pid_file" ] || return 1
    pid="$(tr -d '[:space:]' < "$pid_file" 2>/dev/null || true)"
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    printf '%s' "$pid"
}

pid_alive() {
    local pid="${1:-}" proc_root="${SLSM_PROC_ROOT:-/proc}" stat_line stat_rest state
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    if [ -r "$proc_root/$pid/stat" ]; then
        stat_line="$(cat "$proc_root/$pid/stat" 2>/dev/null || true)"
        if [ -n "$stat_line" ]; then
            stat_rest="${stat_line##*) }"
            state="${stat_rest%% *}"
            case "$state" in
                Z|X|x) return 1 ;;
            esac
        fi
    fi
    return 0
}

is_steam_pid() {
    local pid="${1:-}" proc_root="${SLSM_PROC_ROOT:-/proc}"
    local exe_path comm r r_canon
    [ -n "$pid" ] || return 1

    if [ -e "$proc_root/$pid/exe" ]; then
        exe_path="$(readlink -f "$proc_root/$pid/exe" 2>/dev/null || readlink "$proc_root/$pid/exe" 2>/dev/null || true)"
        if [ -n "$exe_path" ]; then
            for r in "${STEAM_ROOTS[@]}"; do
                [ -n "$r" ] || continue
                r_canon="$(readlink -f "$r" 2>/dev/null || printf '%s' "$r")"
                case "$exe_path" in
                    "$r"/*|"$r_canon"/*) return 0 ;;
                esac
            done
        fi
    fi

    if [ -r "$proc_root/$pid/comm" ]; then
        comm="$(tr -d '\r\n' < "$proc_root/$pid/comm" 2>/dev/null || true)"
        [ "$comm" = "steam" ] && return 0
    fi

    return 1
}

steam_running() {
    local pid
    pid="$(read_steam_pid || true)"
    pid_alive "$pid" && is_steam_pid "$pid"
}

now_ms() {
    local t="${EPOCHREALTIME:-}" sec usec
    if [ -n "$t" ]; then
        case "$t" in
            *[.,]*)
                sec="${t%%[.,]*}"
                usec="${t#*[.,]}000"
                ;;
            *)
                sec="$t"
                usec="000"
                ;;
        esac
        sec="${sec:-0}"
        printf '%s' "$(( 10#$sec * 1000 + 10#${usec:0:3} ))"
    else
        printf '%s' "$(( $(date +%s) * 1000 ))"
    fi
}

timeout_to_ms() {
    local val="${1:-0}" sec frac
    case "$val" in
        ''|*[!0-9.]*|*.*.*) printf '0'; return 0 ;;
    esac
    case "$val" in
        *.*)
            sec="${val%%.*}"
            frac="${val#*.}000"
            sec="${sec:-0}"
            printf '%s' "$(( 10#$sec * 1000 + 10#${frac:0:3} ))"
            ;;
        *)
            printf '%s' "$(( 10#$val * 1000 ))"
            ;;
    esac
}

find_steam_root() {
    local r
    for r in "${STEAM_ROOTS[@]}"; do
        [ -x "$r/steam.sh" ] && { printf '%s' "$r"; return 0; }
    done
    return 1
}

# Print "ACTIVE\t<pid>\t<appid>" for the first non-client process carrying a nonzero SteamAppId=,
# or "NONE" when the scan completed cleanly with no active app.
find_active_steam_app() {
    local client_pid="${1:-}" proc_root="${SLSM_PROC_ROOT:-/proc}"
    if command -v python3 >/dev/null 2>&1; then
        python3 - "$proc_root" "$client_pid" "$$" <<'PY'
import glob, os, sys
proc_root = sys.argv[1]
skip = {p for p in sys.argv[2:] if p}
skip.add(str(os.getpid()))
for path in glob.glob(os.path.join(proc_root, "[0-9]*", "environ")):
    pid = path.rsplit("/", 2)[1]
    if pid in skip:
        continue
    try:
        with open(path, "rb") as f:
            raw = f.read()
    except OSError:
        continue
    for item in raw.split(b"\0"):
        if item.startswith(b"SteamAppId="):
            val = item[11:].decode("utf-8", "replace").strip()
            if val and val != "0":
                print(f"ACTIVE\t{pid}\t{val}")
                sys.exit(0)
print("NONE")
PY
        return $?
    fi

    local env_file pid entry appid
    for env_file in "$proc_root"/[0-9]*/environ; do
        [ -e "$env_file" ] || continue
        pid="${env_file%/*}"; pid="${pid##*/}"
        if [ "$pid" = "$client_pid" ] || [ "$pid" = "$$" ]; then
            continue
        fi
        while IFS= read -r -d '' entry || [ -n "$entry" ]; do
            case "$entry" in
                SteamAppId=*)
                    appid="${entry#SteamAppId=}"
                    appid="${appid#"${appid%%[![:space:]]*}"}"
                    appid="${appid%"${appid##*[![:space:]]}"}"
                    if [ -n "$appid" ] && [ "$appid" != "0" ]; then
                        printf 'ACTIVE\t%s\t%s\n' "$pid" "$appid"
                        return 0
                    fi
                    ;;
            esac
        done 2>/dev/null < "$env_file" || true
    done
    printf 'NONE\n'
}

# Scan /proc/[0-9]*/maps for processes mapping any swap target.
# Outputs "UNREADABLE\t<count>" followed by "HOLDER\t<pid> -> <path>" lines.
scan_mapped_targets() {
    local proc_root="${SLSM_PROC_ROOT:-/proc}"
    local -a targets=() raw_targets=(
        "$SLS_DIR/SLSsteam.so"
        "$CR_DIR/cloud_redirect.so"
        "$CR_DIR/cloud_redirect_cli"
        "$SLS_DIR/path/steam"
    )
    local t canon
    for t in "${raw_targets[@]}"; do
        targets+=("$t")
        canon="$(readlink -f "$t" 2>/dev/null || true)"
        if [ -n "$canon" ] && [ "$canon" != "$t" ]; then
            targets+=("$canon")
        fi
    done

    if command -v python3 >/dev/null 2>&1; then
        python3 - "$proc_root" "${targets[@]}" <<'PY'
import glob, os, sys
proc_root = sys.argv[1]
targets = set(sys.argv[2:])
unreadable = 0
holders = []
for mpath in glob.glob(os.path.join(proc_root, "[0-9]*", "maps")):
    pid = mpath.rsplit("/", 2)[1]
    try:
        with open(mpath, "r", encoding="utf-8", errors="replace") as f:
            seen = set()
            for line in f:
                parts = line.rstrip("\n").split(None, 5)
                if len(parts) < 6:
                    continue
                p = parts[5]
                if p.endswith(" (deleted)"):
                    p = p[:-10]
                if p in targets and p not in seen:
                    seen.add(p)
                    holders.append(f"{pid} -> {p}")
    except PermissionError:
        unreadable += 1
    except OSError:
        pass
print(f"UNREADABLE\t{unreadable}")
for h in holders:
    print(f"HOLDER\t{h}")
PY
        return $?
    fi

    local -a map_files=()
    local f
    for f in "$proc_root"/[0-9]*/maps; do
        [ -e "$f" ] && map_files+=("$f")
    done
    if [ "${#map_files[@]}" -eq 0 ]; then
        printf 'UNREADABLE\t0\n'
        return 0
    fi

    LC_ALL=C awk '
BEGIN {
    nt = 0
    sep = 0
    for (i = 1; i < ARGC; i++) {
        arg = ARGV[i]
        ARGV[i] = ""
        if (!sep) {
            if (arg == "--") {
                sep = 1
            } else {
                nt++
                tlist[nt] = arg
                targets[arg] = 1
            }
            continue
        }
        f = arg
        n = split(f, parts, "/")
        pid = parts[n - 1]
        rc = (getline line < f)
        if (rc < 0) {
            if (ERRNO == "" || ERRNO ~ /Permission|permitted/) {
                unreadable++
            }
            continue
        }
        if (rc == 0) {
            close(f)
            continue
        }
        split("", seen)
        do {
            hit = 0
            for (k = 1; k <= nt; k++) {
                if (index(line, tlist[k]) > 0) {
                    hit = 1
                    break
                }
            }
            if (!hit) continue
            if (match(line, /^[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+[^[:space:]]+[[:space:]]+/)) {
                p = substr(line, RLENGTH + 1)
                sub(/ \(deleted\)$/, "", p)
                if ((p in targets) && !(p in seen)) {
                    seen[p] = 1
                    holders[pid " -> " p] = 1
                }
            }
        } while ((getline line < f) > 0)
        close(f)
    }
    printf "UNREADABLE\t%d\n", unreadable + 0
    for (h in holders) {
        printf "HOLDER\t%s\n", h
    }
}
' "${targets[@]}" -- "${map_files[@]}"
}

wait_for_unmapped_targets() {
    local maps_timeout="${SLSM_STOP_STEAM_MAPS_TIMEOUT:-15}"
    local poll="${SLSM_STOP_STEAM_POLL:-0.25}"
    local start_ms deadline_ms now scan_out line unreadable seen_unreadable noted_unreadable=0
    local -a holders=()
    local announced=0

    start_ms="$(now_ms)"
    deadline_ms=$(( start_ms + $(timeout_to_ms "$maps_timeout") ))

    while true; do
        if ! scan_out="$(scan_mapped_targets)"; then
            bad "mapped-file scan failed; refusing to modify files"
            return 1
        fi
        unreadable=0
        seen_unreadable=0
        holders=()
        while IFS= read -r line; do
            case "$line" in
                UNREADABLE$'\t'*)
                    unreadable="${line#UNREADABLE$'\t'}"
                    case "$unreadable" in
                        ''|*[!0-9]*) ;;
                        *) seen_unreadable=1 ;;
                    esac
                    ;;
                HOLDER$'\t'*)
                    holders+=("${line#HOLDER$'\t'}")
                    ;;
            esac
        done <<< "$scan_out"

        if [ "$seen_unreadable" -ne 1 ]; then
            bad "mapped-file scan produced invalid output (missing UNREADABLE marker); refusing to modify files"
            return 1
        fi

        if [ "$noted_unreadable" = 0 ] && [ "${unreadable:-0}" -gt 0 ]; then
            dim "skipped $unreadable unreadable /proc/<pid>/maps entries"
            noted_unreadable=1
        fi

        if [ "${#holders[@]}" -eq 0 ]; then
            return 0
        fi

        now="$(now_ms)"
        if [ "$now" -ge "$deadline_ms" ]; then
            local h
            for h in "${holders[@]}"; do
                bad "still mapped: $h"
            done
            bad "refusing to modify files while processes still hold swap targets"
            return 1
        fi

        if [ "$announced" = 0 ]; then
            dim "waiting for processes releasing staged files to exit (timeout ${maps_timeout}s)..."
            announced=1
        fi
        sleep "$poll"
    done
}

cmd_stop_steam() {
    local pid="" steam_root="" app_hit app_pid app_id
    local stop_timeout="${SLSM_STOP_STEAM_TIMEOUT:-60}"
    local kill_timeout="${SLSM_STOP_STEAM_KILL_TIMEOUT:-15}"
    local poll="${SLSM_STOP_STEAM_POLL:-0.25}"
    local start_ms deadline_ms next_note_ms now elapsed_s stopped=0

    pid="$(read_steam_pid || true)"
    if [ -n "$pid" ] && pid_alive "$pid" && is_steam_pid "$pid"; then
        if [ "${SLSM_STOP_STEAM:-}" != "force" ]; then
            if ! app_hit="$(find_active_steam_app "$pid")"; then
                bad "active-game check failed; refusing to stop Steam"
                dim "  Set SLSM_STOP_STEAM=force to bypass the active-game check."
                return 1
            fi
            case "$app_hit" in
                ACTIVE$'\t'*)
                    app_pid="${app_hit#ACTIVE$'\t'}"
                    app_id="${app_pid#*$'\t'}"
                    app_pid="${app_pid%%$'\t'*}"
                    bad "Steam app $app_id is running (pid $app_pid) — refusing to stop Steam"
                    dim "  Close the game first, or set SLSM_STOP_STEAM=force to shut Steam down anyway."
                    return 1
                    ;;
                NONE)
                    ;;
                *)
                    bad "active-game check returned unexpected output; refusing to stop Steam"
                    dim "  Set SLSM_STOP_STEAM=force to bypass the active-game check."
                    return 1
                    ;;
            esac
        else
            warn "SLSM_STOP_STEAM=force: bypassing active-game check"
        fi

        steam_root="$(find_steam_root || true)"
        if [ -n "$steam_root" ]; then
            local stop_ms shutdown_pid=""
            stop_ms="$(timeout_to_ms "$stop_timeout")"
            dim "shutting down Steam (pid $pid) via $steam_root/steam.sh -shutdown..."
            start_ms="$(now_ms)"
            deadline_ms=$(( start_ms + stop_ms ))
            next_note_ms=$(( start_ms + 5000 ))
            if [ "$stop_ms" -gt 0 ]; then
                if command -v timeout >/dev/null 2>&1; then
                    (
                        cd "$steam_root" && \
                        exec timeout -k 1 "$stop_timeout" \
                            env -u STEAM_FORCE_CLIENT -u LD_AUDIT -u LD_PRELOAD \
                            "$steam_root/steam.sh" -shutdown
                    ) </dev/null >/dev/null 2>&1 &
                else
                    (
                        cd "$steam_root" && \
                        exec env -u STEAM_FORCE_CLIENT -u LD_AUDIT -u LD_PRELOAD \
                            "$steam_root/steam.sh" -shutdown
                    ) </dev/null >/dev/null 2>&1 &
                fi
                shutdown_pid=$!
            fi

            dim "waiting for Steam (pid $pid) and children to exit (timeout ${stop_timeout}s)..."
            while true; do
                if ! pid_alive "$pid"; then
                    stopped=1
                    ok "Steam stopped gracefully"
                    break
                fi
                now="$(now_ms)"
                if [ "$now" -ge "$deadline_ms" ]; then
                    break
                fi
                if [ "$now" -ge "$next_note_ms" ]; then
                    elapsed_s=$(( (now - start_ms) / 1000 ))
                    dim "still waiting for Steam (pid $pid) to shut down (${elapsed_s}s)..."
                    next_note_ms=$(( now + 5000 ))
                fi
                sleep "$poll"
            done
            if [ -n "$shutdown_pid" ]; then
                kill -TERM "$shutdown_pid" 2>/dev/null || true
                wait "$shutdown_pid" 2>/dev/null || true
            fi
        else
            warn "steam.sh not found in Steam roots; falling back to SIGTERM for pid $pid"
        fi

        if [ "$stopped" = 0 ] && pid_alive "$pid"; then
            warn "Steam (pid $pid) did not exit gracefully; sending SIGTERM (timeout ${kill_timeout}s)..."
            kill -TERM "$pid" 2>/dev/null || true
            start_ms="$(now_ms)"
            deadline_ms=$(( start_ms + $(timeout_to_ms "$kill_timeout") ))
            while true; do
                if ! pid_alive "$pid"; then
                    stopped=1
                    ok "Steam stopped (SIGTERM)"
                    break
                fi
                now="$(now_ms)"
                if [ "$now" -ge "$deadline_ms" ]; then
                    bad "Steam (pid $pid) did not exit after SIGTERM (${kill_timeout}s); close it manually and re-run"
                    return 1
                fi
                sleep "$poll"
            done
        fi
    else
        ok "Steam is not running"
    fi

    wait_for_unmapped_targets
}

env_conf_value() {
    [ -f "$ENV_CONF" ] || return 0
    sed -n 's/^[[:space:]]*STEAM_FORCE_CLIENT[[:space:]]*=[[:space:]]*//p' "$ENV_CONF" \
        | tail -n1 | tr -d "\"' \r"
}

sync_systemd_env() {
    local val="${1:-}"
    command -v systemctl >/dev/null 2>&1 || return 0
    if [ -n "$val" ]; then
        systemctl --user set-environment "STEAM_FORCE_CLIENT=$val" >/dev/null 2>&1 || true
    else
        systemctl --user unset-environment STEAM_FORCE_CLIENT >/dev/null 2>&1 || true
    fi
}

# Migrate legacy .32.bak CloudRedirect backups from older build-cloudredirect.sh runs.
migrate_cr_backups() {
    local f
    for f in cloud_redirect.so cloud_redirect_cli; do
        if [ -f "$CR_DIR/$f.32.bak" ]; then
            if [ ! -f "$CR_DIR/$f.32" ]; then
                mv -f "$CR_DIR/$f.32.bak" "$CR_DIR/$f.32" || die "cannot migrate $CR_DIR/$f.32.bak"
                dim "migrated $f.32.bak -> $f.32"
            elif cmp -s "$CR_DIR/$f.32.bak" "$CR_DIR/$f.32"; then
                rm -f "$CR_DIR/$f.32.bak"
            fi
        fi
    done
}

# --- atomic file helpers ---------------------------------------------------
atomic_install() {
    local mode="$1" src="$2" dst="$3" dir tmp
    dir="$(dirname "$dst")"
    mkdir -p "$dir" || return 1
    tmp="$dir/.$(basename "$dst").moon64-tmp.$$"
    install -m "$mode" "$src" "$tmp" || { rm -f "$tmp" 2>/dev/null || true; return 1; }
    mv -f "$tmp" "$dst" || { rm -f "$tmp" 2>/dev/null || true; return 1; }
}

atomic_copy_preserve() {
    local src="$1" dst="$2" dir tmp
    dir="$(dirname "$dst")"
    mkdir -p "$dir" || return 1
    tmp="$dir/.$(basename "$dst").moon64-tmp.$$"
    cp -a "$src" "$tmp" || { rm -f "$tmp" 2>/dev/null || true; return 1; }
    mv -f "$tmp" "$dst" || { rm -f "$tmp" 2>/dev/null || true; return 1; }
}

# --- client selection ------------------------------------------------------
# steam.sh decides the client from these switches. Both must agree; leaving one
# behind is how a stack ends up half-migrated.
enable_64bit_client() {
    local r
    for r in "${STEAM_ROOTS[@]}"; do
        [ -d "$r" ] || continue
        : > "$r/.steam-enable-steamrt64-client" || return 1
        rm -f "$r/.steam-disable-steamrt64-client" || return 1
    done
}

disable_64bit_client() {
    local r
    for r in "${STEAM_ROOTS[@]}"; do
        [ -d "$r" ] || continue
        rm -f "$r/.steam-enable-steamrt64-client" || return 1
        : > "$r/.steam-disable-steamrt64-client" || return 1
    done
}

# --- Steam desktop entry ---------------------------------------------------
# A normal Steam launch goes through the desktop entry, so `on` points every
# Exec= of the Steam entries at the SLSsteam wrapper and `off` puts them back.
# System files are never edited: when only a system entry exists, `on` writes a
# user-level override in $APPS_DIR and leaves <file>.moon64-created; an existing
# user-level entry is edited in place after a one-time <file>.moon64-bak copy.

# system_desktop_file <name> — first <dir>/applications/<name> in $XDG_DATA_DIRS.
system_desktop_file() {
    local name="$1" d
    local -a dirs=()
    IFS=: read -r -a dirs <<< "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    for d in "${dirs[@]}"; do
        [ -n "$d" ] && [ "$d/applications" != "$APPS_DIR" ] || continue
        if [ -f "$d/applications/$name" ]; then
            printf '%s' "$d/applications/$name"
            return 0
        fi
    done
    return 1
}

# exec_next_token <str> — split one raw Exec= token (double quotes and
# backslash escapes respected) into EXEC_TOK; the remainder goes to EXEC_REST.
EXEC_TOK=""; EXEC_REST=""; EXEC_ENV=""; EXEC_PROG=""; EXEC_ARGS=""
exec_next_token() {
    local s="$1" i=0 n c q=0 esc=0
    s="${s#"${s%%[![:space:]]*}"}"
    n=${#s}
    while [ "$i" -lt "$n" ]; do
        c="${s:i:1}"
        if [ "$esc" = 1 ]; then
            esc=0
        elif [ "$c" = "\\" ]; then
            esc=1
        elif [ "$c" = '"' ]; then
            q=$((1 - q))
        elif [ "$q" = 0 ]; then
            case "$c" in [[:space:]]) break ;; esac
        fi
        i=$((i + 1))
    done
    [ "$q" = 0 ] || return 1
    EXEC_TOK="${s:0:i}"
    EXEC_REST="${s:i}"
    EXEC_REST="${EXEC_REST#"${EXEC_REST%%[![:space:]]*}"}"
}

# own_auditors_only <LD_AUDIT value> — true when it names only our auditors.
own_auditors_only() {
    local v="$1" a
    local -a parts=()
    v="${v#\"}"; v="${v%\"}"
    IFS=: read -r -a parts <<< "$v"
    for a in "${parts[@]}"; do
        case "$a" in
            ''|*/SLSsteam.so|*/library-inject.so|*/netsock64.so) ;;
            *) return 1 ;;
        esac
    done
}

# exec_split <Exec value> — parse "[env NAME=VAL...] PROGRAM [ARGS]" into
# EXEC_ENV (kept assignments, raw), EXEC_PROG (unquoted) and EXEC_ARGS (raw).
# An LD_AUDIT naming only our own auditors is dropped: the wrapper builds that
# stack itself. env options, unbalanced quotes or escapes in the program
# return 1, so callers refuse instead of guessing.
exec_split() {
    local name
    EXEC_ENV=""; EXEC_PROG=""; EXEC_ARGS=""
    exec_next_token "$1" || return 1
    if [ "$EXEC_TOK" = env ]; then
        while :; do
            exec_next_token "$EXEC_REST" || return 1
            case "$EXEC_TOK" in [A-Za-z_]*=*) ;; *) break ;; esac
            name="${EXEC_TOK%%=*}"
            case "$name" in *[!A-Za-z0-9_]*) return 1 ;; esac
            if [ "$name" != LD_AUDIT ] || ! own_auditors_only "${EXEC_TOK#*=}"; then
                EXEC_ENV="${EXEC_ENV:+$EXEC_ENV }$EXEC_TOK"
            fi
        done
    fi
    EXEC_PROG="$EXEC_TOK"
    case "$EXEC_PROG" in \"*\") EXEC_PROG="${EXEC_PROG:1:${#EXEC_PROG}-2}" ;; esac
    case "$EXEC_PROG" in ''|*[\\\"\`\$]*) return 1 ;; esac
    EXEC_ARGS="$EXEC_REST"
}

is_steam_program() {
    case "${1##*/}" in
        steam|steam-native|steam-runtime|steam.sh) return 0 ;;
    esac
    return 1
}

# desktop_exec_arg <path> — the path as one Exec= argument (quoted if needed).
desktop_exec_arg() {
    local s="$1"
    case "$s" in *[\\\"\`\$]*|*$'\n'*) return 1 ;; esac
    case "$s" in *[[:space:]\'\>\<~\|\&\;\*\?\#\(\)]*) s="\"$s\"" ;; esac
    printf '%s' "${s//%/%%}"
}

# desktop_rewrite_file <src> <dst> — write src to dst with every Exec= running
# the wrapper; every other byte is copied unchanged. Returns 1 when an Exec= is
# not a recognisable Steam launch or there is no [Desktop Entry] Exec=.
desktop_rewrite_file() {
    local src="$1" dst="$2" line key cr section="" main=0 first=1 nl_end=1 exec_arg
    exec_arg="$(desktop_exec_arg "$SLS_WRAPPER")" || return 1
    [ -n "$(tail -c1 "$src" 2>/dev/null)" ] && nl_end=0
    {
        while IFS= read -r line || [ -n "$line" ]; do
            [ "$first" = 1 ] || printf '\n'
            first=0
            cr=""
            case "$line" in *$'\r') cr=$'\r'; line="${line%$'\r'}" ;; esac
            case "$line" in '['*) section="$line" ;; esac
            if [[ "$line" =~ ^(Exec[[:space:]]*=[[:space:]]*)(.*)$ ]]; then
                key="${BASH_REMATCH[1]}"
                exec_split "${BASH_REMATCH[2]}" || return 1
                is_steam_program "$EXEC_PROG" || return 1
                [ "$section" = "[Desktop Entry]" ] && main=1
                line="$key${EXEC_ENV:+env $EXEC_ENV }$exec_arg${EXEC_ARGS:+ $EXEC_ARGS}"
            fi
            printf '%s%s' "$line" "$cr"
        done < "$src"
        [ "$first" = 1 ] || [ "$nl_end" = 0 ] || printf '\n'
    } > "$dst" || return 1
    [ "$main" = 1 ] || return 1
    chmod --reference="$src" "$dst" 2>/dev/null || true
}

# desktop_entry_state <file> — "ours" when every Exec= runs the wrapper,
# "partial" when only some do, "foreign <program>" when the main Exec= runs
# something else, "invalid" when `on` would refuse to rewrite the file.
desktop_entry_state() {
    local line section="" main_prog="" seen_main=0 all_ours=1
    while IFS= read -r line || [ -n "$line" ]; do
        line="${line%$'\r'}"
        case "$line" in '['*) section="$line" ;; esac
        [[ "$line" =~ ^Exec[[:space:]]*=[[:space:]]*(.*)$ ]] || continue
        if ! exec_split "${BASH_REMATCH[1]}" || ! is_steam_program "$EXEC_PROG"; then
            printf 'invalid'
            return 0
        fi
        [ "$EXEC_PROG" = "$SLS_WRAPPER" ] || all_ours=0
        if [ "$section" = "[Desktop Entry]" ] && [ "$seen_main" = 0 ]; then
            seen_main=1
            main_prog="$EXEC_PROG"
        fi
    done < "$1"
    if [ "$seen_main" = 0 ]; then
        printf 'invalid'
    elif [ "$all_ours" = 1 ]; then
        printf 'ours'
    elif [ "$main_prog" = "$SLS_WRAPPER" ]; then
        printf 'partial'
    else
        printf 'foreign %s' "$main_prog"
    fi
}

# desktop_targets — "<user-level path>\t<source>" per Steam entry: the user
# file when it exists, otherwise the system file it would be overridden from.
desktop_targets() {
    local name sys
    for name in "${STEAM_DESKTOP_NAMES[@]}"; do
        if [ -f "$APPS_DIR/$name" ]; then
            printf '%s\t%s\n' "$APPS_DIR/$name" "$APPS_DIR/$name"
        elif sys="$(system_desktop_file "$name")"; then
            printf '%s\t%s\n' "$APPS_DIR/$name" "$sys"
        fi
    done
}

# --- two-phase transaction rollback ----------------------------------------
TX_ACTIVE=0
TX_RB_DIR=""
DESKTOP_TX_PATHS=()

snapshot_file() {
    local live="$1" key="$2"
    if [ -f "$live" ]; then
        cp -a "$live" "$TX_RB_DIR/$key" || die "cannot snapshot $live"
    else
        : > "$TX_RB_DIR/$key.absent" || die "cannot mark $live absent"
    fi
}

restore_snapshot_file() {
    local key="$1" live="$2"
    if [ -f "$TX_RB_DIR/$key" ]; then
        atomic_copy_preserve "$TX_RB_DIR/$key" "$live" || true
    elif [ -f "$TX_RB_DIR/$key.absent" ]; then
        rm -f "$live" 2>/dev/null || true
    fi
}

snapshot_roots() {
    local i=0 r
    mkdir -p "$TX_RB_DIR/roots" || die "cannot create $TX_RB_DIR/roots"
    for r in "${STEAM_ROOTS[@]}"; do
        [ -d "$r" ] || { i=$((i+1)); continue; }
        [ -e "$r/.steam-enable-steamrt64-client" ] && : > "$TX_RB_DIR/roots/$i.en" || true
        [ -e "$r/.steam-disable-steamrt64-client" ] && : > "$TX_RB_DIR/roots/$i.dis" || true
        i=$((i+1))
    done
}

restore_roots() {
    local i=0 r
    for r in "${STEAM_ROOTS[@]}"; do
        [ -d "$r" ] || { i=$((i+1)); continue; }
        if [ -e "$TX_RB_DIR/roots/$i.en" ]; then
            : > "$r/.steam-enable-steamrt64-client" 2>/dev/null || true
        else
            rm -f "$r/.steam-enable-steamrt64-client" 2>/dev/null || true
        fi
        if [ -e "$TX_RB_DIR/roots/$i.dis" ]; then
            : > "$r/.steam-disable-steamrt64-client" 2>/dev/null || true
        else
            rm -f "$r/.steam-disable-steamrt64-client" 2>/dev/null || true
        fi
        i=$((i+1))
    done
}

tx_rollback() {
    [ -n "$TX_RB_DIR" ] && [ -d "$TX_RB_DIR" ] || return 0
    warn "rolling back partial switch..."
    restore_snapshot_file "sls" "$SLS_DIR/SLSsteam.so"
    restore_snapshot_file "cr_so" "$CR_DIR/cloud_redirect.so"
    restore_snapshot_file "cr_cli" "$CR_DIR/cloud_redirect_cli"
    restore_snapshot_file "wrapper" "$SLS_DIR/path/steam"
    restore_snapshot_file "env_conf" "$ENV_CONF"
    local k
    for k in "${!DESKTOP_TX_PATHS[@]}"; do
        restore_snapshot_file "desktop.$k" "${DESKTOP_TX_PATHS[k]}"
    done
    restore_roots
    sync_systemd_env "$(env_conf_value)"
}

tx_cleanup() {
    rm -rf "$STAGE_DIR" 2>/dev/null || true
}

tx_exit() {
    local rc=$?
    if [ "$TX_ACTIVE" = 1 ]; then
        TX_ACTIVE=0
        tx_rollback
    fi
    tx_cleanup
    exit "$rc"
}

tx_abort() {
    local sig="$1"
    if [ "$TX_ACTIVE" = 1 ]; then
        TX_ACTIVE=0
        tx_rollback
        bad "interrupted ($sig) — rolled back"
    fi
    tx_cleanup
    trap - INT TERM HUP EXIT
    exit 130
}

tx_begin_stage() {
    rm -rf "$STAGE_DIR" || die "cannot clean $STAGE_DIR"
    mkdir -p "$STAGE_DIR/rollback" || die "cannot create $STAGE_DIR"
    TX_RB_DIR="$STAGE_DIR/rollback"
    TX_ACTIVE=0
    trap 'tx_exit' EXIT
    trap 'tx_abort INT' INT
    trap 'tx_abort TERM' TERM
    trap 'tx_abort HUP' HUP
}

tx_commit_done() {
    TX_ACTIVE=0
    trap - INT TERM HUP EXIT
    tx_cleanup
}

# --- save originals before Phase 2 commit ----------------------------------
save_original_lib() {
    local active="$1" saved="$2"
    if [ -f "$active" ] && [ ! -f "$saved" ] && [ "$(elfbits "$active")" != 64 ]; then
        atomic_copy_preserve "$active" "$saved" || die "cannot save $active"
    fi
}

# --- commands --------------------------------------------------------------
cmd_on() {
    local wrapper="$SLS_DIR/path/steam"
    local wrapper_bak="$MOON_DIR/wrapper.32.bak"
    local env_saved="$MOON_DIR/steam-32bit.conf.32"
    local env_absent="$MOON_DIR/steam-32bit.conf.absent"
    local stage_cr=0 stage_cr_cli=0 dt_dst dt_src k dt_ours=0
    local -a dt_user=()

    cmd_stop_steam || exit 1
    require_file_cmd
    migrate_cr_backups

    [ -f "$MOON_DIR/SLSsteam.so.64" ] || die "$MOON_DIR/SLSsteam.so.64 missing — run install.sh first"
    [ -f "$MOON_DIR/wrapper.64.sh" ] || die "$MOON_DIR/wrapper.64.sh missing — run install.sh"

    # --- Phase 1: stage & verify under $MOON_DIR/staged/ -------------------
    tx_begin_stage

    [ "$(elfbits "$MOON_DIR/SLSsteam.so.64")" = 64 ] || die "$MOON_DIR/SLSsteam.so.64 is not ELF 64-bit"
    install -m 755 "$MOON_DIR/SLSsteam.so.64" "$STAGE_DIR/SLSsteam.so" || die "cannot stage SLSsteam.so"
    [ "$(elfbits "$STAGE_DIR/SLSsteam.so")" = 64 ] || die "staged SLSsteam.so failed ELF 64-bit check"
    cmp -s "$MOON_DIR/SLSsteam.so.64" "$STAGE_DIR/SLSsteam.so" || die "staged SLSsteam.so verification mismatch"

    if [ -f "$CR_DIR/cloud_redirect.so.64" ]; then
        [ "$(elfbits "$CR_DIR/cloud_redirect.so.64")" = 64 ] || die "$CR_DIR/cloud_redirect.so.64 is not ELF 64-bit"
        install -m 755 "$CR_DIR/cloud_redirect.so.64" "$STAGE_DIR/cloud_redirect.so" || die "cannot stage cloud_redirect.so"
        [ "$(elfbits "$STAGE_DIR/cloud_redirect.so")" = 64 ] || die "staged cloud_redirect.so failed ELF 64-bit check"
        stage_cr=1
        if [ -f "$CR_DIR/cloud_redirect_cli.64" ]; then
            [ "$(elfbits "$CR_DIR/cloud_redirect_cli.64")" = 64 ] || die "$CR_DIR/cloud_redirect_cli.64 is not ELF 64-bit"
            install -m 755 "$CR_DIR/cloud_redirect_cli.64" "$STAGE_DIR/cloud_redirect_cli" || die "cannot stage cloud_redirect_cli"
            [ "$(elfbits "$STAGE_DIR/cloud_redirect_cli")" = 64 ] || die "staged cloud_redirect_cli failed ELF 64-bit check"
            stage_cr_cli=1
        fi
    fi

    [ -s "$MOON_DIR/wrapper.64.sh" ] || die "$MOON_DIR/wrapper.64.sh is empty"
    install -m 755 "$MOON_DIR/wrapper.64.sh" "$STAGE_DIR/wrapper" || die "cannot stage wrapper"

    cat > "$STAGE_DIR/steam-32bit.conf" <<'CONF' || die "cannot stage steam-32bit.conf"
# Managed by moon64 — 64-bit steamrt64 client active (run 'moon64 off' to restore 32-bit).
STEAM_FORCE_CLIENT=steamrt64
CONF

    # Desktop entries: stage the rewritten copy of each one that does not yet
    # start the wrapper. Refuse the whole switch rather than guess at an Exec=.
    while IFS=$'\t' read -r dt_dst dt_src; do
        [ -n "$dt_dst" ] || continue
        desktop_rewrite_file "$dt_src" "$STAGE_DIR/desktop.new" \
            || die "cannot point $dt_src at $SLS_WRAPPER: an Exec= line is not a recognisable Steam launch (refusing to guess)"
        if [ -f "$dt_dst" ] && cmp -s "$dt_dst" "$STAGE_DIR/desktop.new"; then
            rm -f "$STAGE_DIR/desktop.new"
            continue
        fi
        mv -f "$STAGE_DIR/desktop.new" "$STAGE_DIR/desktop.${#dt_user[@]}" || die "cannot stage $dt_dst"
        dt_user+=("$dt_dst")
    done < <(desktop_targets)

    # Save 32-bit originals onto disk BEFORE Phase 2 mutates any active file.
    mkdir -p "$MOON_DIR" "$SLS_DIR" "$(dirname "$wrapper")" || die "cannot create target directories"
    save_original_lib "$SLS_DIR/SLSsteam.so" "$SLS_DIR/SLSsteam.so.32"
    if [ "$stage_cr" = 1 ]; then
        save_original_lib "$CR_DIR/cloud_redirect.so" "$CR_DIR/cloud_redirect.so.32"
        [ "$stage_cr_cli" = 1 ] && save_original_lib "$CR_DIR/cloud_redirect_cli" "$CR_DIR/cloud_redirect_cli.32"
    fi
    if [ -f "$wrapper" ] && [ ! -f "$wrapper_bak" ] && ! cmp -s "$wrapper" "$MOON_DIR/wrapper.64.sh"; then
        atomic_copy_preserve "$wrapper" "$wrapper_bak" || die "cannot back up $wrapper"
    fi
    if [ -f "$ENV_CONF" ]; then
        if [ ! -f "$env_saved" ] && [ ! -f "$env_absent" ] && [ "$(env_conf_value)" != "steamrt64" ]; then
            atomic_copy_preserve "$ENV_CONF" "$env_saved" || die "cannot back up $ENV_CONF"
        fi
    elif [ ! -f "$env_saved" ] && [ ! -f "$env_absent" ]; then
        : > "$env_absent" || die "cannot mark $ENV_CONF absent"
    fi
    for dt_dst in "${dt_user[@]}"; do
        if [ -e "$dt_dst.moon64-bak" ] || [ -e "$dt_dst.moon64-created" ]; then
            continue
        elif [ -f "$dt_dst" ]; then
            atomic_copy_preserve "$dt_dst" "$dt_dst.moon64-bak" || die "cannot back up $dt_dst"
        else
            mkdir -p "$APPS_DIR" || die "cannot create $APPS_DIR"
            : > "$dt_dst.moon64-created" || die "cannot record $dt_dst as a moon64 override"
        fi
    done

    # Snapshot exact pre-commit live state for rollback if Phase 2 fails/aborts.
    snapshot_file "$SLS_DIR/SLSsteam.so" "sls"
    snapshot_file "$CR_DIR/cloud_redirect.so" "cr_so"
    snapshot_file "$CR_DIR/cloud_redirect_cli" "cr_cli"
    snapshot_file "$wrapper" "wrapper"
    snapshot_file "$ENV_CONF" "env_conf"
    DESKTOP_TX_PATHS=("${dt_user[@]}")
    for k in "${!dt_user[@]}"; do
        snapshot_file "${dt_user[k]}" "desktop.$k"
    done
    snapshot_roots

    # --- Phase 2: atomic commit --------------------------------------------
    TX_ACTIVE=1

    atomic_install 755 "$STAGE_DIR/SLSsteam.so" "$SLS_DIR/SLSsteam.so" || die "cannot activate 64-bit SLSsteam.so"
    if [ "$stage_cr" = 1 ]; then
        atomic_install 755 "$STAGE_DIR/cloud_redirect.so" "$CR_DIR/cloud_redirect.so" || die "cannot activate 64-bit cloud_redirect.so"
        if [ "$stage_cr_cli" = 1 ]; then
            atomic_install 755 "$STAGE_DIR/cloud_redirect_cli" "$CR_DIR/cloud_redirect_cli" || die "cannot activate 64-bit cloud_redirect_cli"
        fi
    fi
    atomic_install 755 "$STAGE_DIR/wrapper" "$wrapper" || die "cannot install 64-bit wrapper"
    atomic_install 644 "$STAGE_DIR/steam-32bit.conf" "$ENV_CONF" || die "cannot update $ENV_CONF"
    enable_64bit_client || die "cannot write steamrt64 client markers"
    sync_systemd_env "steamrt64"
    for k in "${!dt_user[@]}"; do
        atomic_copy_preserve "$STAGE_DIR/desktop.$k" "${dt_user[k]}" || die "cannot update ${dt_user[k]}"
    done

    # Post-commit ELF verification
    [ "$(elfbits "$SLS_DIR/SLSsteam.so")" = 64 ] || die "post-commit check: SLSsteam.so is not 64-bit"
    if [ "$stage_cr" = 1 ]; then
        [ "$(elfbits "$CR_DIR/cloud_redirect.so")" = 64 ] || die "post-commit check: cloud_redirect.so is not 64-bit"
        if [ "$stage_cr_cli" = 1 ]; then
            [ "$(elfbits "$CR_DIR/cloud_redirect_cli")" = 64 ] || die "post-commit check: cloud_redirect_cli is not 64-bit"
        fi
    fi
    for k in "${!dt_user[@]}"; do
        [ "$(desktop_entry_state "${dt_user[k]}")" = ours ] || die "post-commit check: ${dt_user[k]} does not start $SLS_WRAPPER"
    done

    tx_commit_done

    ok "SLSsteam.so: 64-bit active"
    if [ "$stage_cr" = 1 ]; then
        ok "CloudRedirect: 64-bit active"
    elif [ "$(elfbits "$CR_DIR/cloud_redirect.so")" = 32 ]; then
        warn "CloudRedirect staged only as 32-bit; cloud saves will be inactive"
        dim "rebuild with: install.sh --with-cloudredirect"
    fi
    ok "wrapper: $wrapper (64-bit)"
    ok "environment.d: $ENV_CONF (STEAM_FORCE_CLIENT=steamrt64)"
    for dt_dst in "${STEAM_DESKTOP_NAMES[@]}"; do
        dt_dst="$APPS_DIR/$dt_dst"
        if [ -f "$dt_dst" ] && [ "$(desktop_entry_state "$dt_dst")" = ours ]; then
            ok "desktop entry: $dt_dst starts $SLS_WRAPPER"
            dt_ours=1
        fi
    done
    if [ "$dt_ours" = 0 ]; then
        warn "no Steam desktop entry found in $APPS_DIR or \$XDG_DATA_DIRS; a launcher will not run the 64-bit stack"
    fi
    if [ ! -f "$MOON_DIR/netsock64.so" ]; then
        warn "netsock64.so missing — the P2P cert patch will not be applied"
    fi
    if [ "${STEAM_FORCE_CLIENT:-}" = "ubuntu12_32" ]; then
        warn "this shell still exports STEAM_FORCE_CLIENT=ubuntu12_32; unset it before launching steam.sh directly"
    fi
    printf '\n'
    if [ "$dt_ours" = 1 ]; then
        ok "64-bit stack active — start Steam from your normal launcher"
    else
        ok "64-bit stack active — start Steam with $SLS_WRAPPER"
    fi
}

cmd_off() {
    local wrapper="$SLS_DIR/path/steam"
    local wrapper_bak="$MOON_DIR/wrapper.32.bak"
    local env_saved="$MOON_DIR/steam-32bit.conf.32"
    local env_absent="$MOON_DIR/steam-32bit.conf.absent"
    local stage_sls=0 stage_cr=0 stage_cr_cli=0 stage_wrap=0
    local env_action="keep" dt k
    local -a dr_user=() dr_mode=()

    cmd_stop_steam || exit 1
    require_file_cmd
    migrate_cr_backups

    # --- Phase 1: stage & verify 32-bit originals under $MOON_DIR/staged/ --
    tx_begin_stage

    if [ -f "$SLS_DIR/SLSsteam.so.32" ]; then
        [ "$(elfbits "$SLS_DIR/SLSsteam.so.32")" = 32 ] || die "$SLS_DIR/SLSsteam.so.32 is not ELF 32-bit"
        cp -a "$SLS_DIR/SLSsteam.so.32" "$STAGE_DIR/SLSsteam.so" || die "cannot stage 32-bit SLSsteam.so"
        [ "$(elfbits "$STAGE_DIR/SLSsteam.so")" = 32 ] || die "staged SLSsteam.so failed ELF 32-bit check"
        cmp -s "$STAGE_DIR/SLSsteam.so" "$SLS_DIR/SLSsteam.so.32" || die "staged SLSsteam.so byte mismatch"
        stage_sls=1
    elif [ "$(elfbits "$SLS_DIR/SLSsteam.so")" = 64 ]; then
        die "cannot restore 32-bit stack: $SLS_DIR/SLSsteam.so.32 missing while active SLSsteam.so is 64-bit"
    fi

    if [ -f "$CR_DIR/cloud_redirect.so.32" ]; then
        [ "$(elfbits "$CR_DIR/cloud_redirect.so.32")" = 32 ] || die "$CR_DIR/cloud_redirect.so.32 is not ELF 32-bit"
        cp -a "$CR_DIR/cloud_redirect.so.32" "$STAGE_DIR/cloud_redirect.so" || die "cannot stage 32-bit cloud_redirect.so"
        [ "$(elfbits "$STAGE_DIR/cloud_redirect.so")" = 32 ] || die "staged cloud_redirect.so failed ELF 32-bit check"
        cmp -s "$STAGE_DIR/cloud_redirect.so" "$CR_DIR/cloud_redirect.so.32" || die "staged cloud_redirect.so byte mismatch"
        stage_cr=1
    fi
    if [ -f "$CR_DIR/cloud_redirect_cli.32" ]; then
        [ "$(elfbits "$CR_DIR/cloud_redirect_cli.32")" = 32 ] || die "$CR_DIR/cloud_redirect_cli.32 is not ELF 32-bit"
        cp -a "$CR_DIR/cloud_redirect_cli.32" "$STAGE_DIR/cloud_redirect_cli" || die "cannot stage 32-bit cloud_redirect_cli"
        [ "$(elfbits "$STAGE_DIR/cloud_redirect_cli")" = 32 ] || die "staged cloud_redirect_cli failed ELF 32-bit check"
        cmp -s "$STAGE_DIR/cloud_redirect_cli" "$CR_DIR/cloud_redirect_cli.32" || die "staged cloud_redirect_cli byte mismatch"
        stage_cr_cli=1
    fi

    if [ -f "$wrapper_bak" ]; then
        cp -a "$wrapper_bak" "$STAGE_DIR/wrapper" || die "cannot stage 32-bit wrapper"
        cmp -s "$STAGE_DIR/wrapper" "$wrapper_bak" || die "staged wrapper byte mismatch"
        stage_wrap=1
    fi

    if [ -f "$env_saved" ]; then
        cp -a "$env_saved" "$STAGE_DIR/steam-32bit.conf" || die "cannot stage saved $ENV_CONF"
        cmp -s "$STAGE_DIR/steam-32bit.conf" "$env_saved" || die "staged steam-32bit.conf byte mismatch"
        env_action="restore"
    elif [ -f "$env_absent" ]; then
        env_action="remove"
    elif [ -f "$ENV_CONF" ] && [ "$(env_conf_value)" = "steamrt64" ]; then
        cat > "$STAGE_DIR/steam-32bit.conf" <<'CONF' || die "cannot stage fallback steam-32bit.conf"
# Restored to 32-bit ubuntu12_32 by moon64 off.
STEAM_FORCE_CLIENT=ubuntu12_32
CONF
        env_action="fallback"
    fi

    # Desktop entries: back to the saved original, or drop the override `on`
    # created. An entry that already started the wrapper before `on` is left.
    for dt in "${STEAM_DESKTOP_NAMES[@]}"; do
        dt="$APPS_DIR/$dt"
        k="${#dr_user[@]}"
        if [ -f "$dt.moon64-bak" ]; then
            cp -a "$dt.moon64-bak" "$STAGE_DIR/desktop.$k" || die "cannot stage $dt.moon64-bak"
            cmp -s "$STAGE_DIR/desktop.$k" "$dt.moon64-bak" || die "staged $dt byte mismatch"
            dr_user+=("$dt"); dr_mode+=(restore)
        elif [ -e "$dt.moon64-created" ]; then
            dr_user+=("$dt"); dr_mode+=(remove)
        fi
    done

    # Snapshot current live state for rollback if Phase 2 fails/aborts.
    snapshot_file "$SLS_DIR/SLSsteam.so" "sls"
    snapshot_file "$CR_DIR/cloud_redirect.so" "cr_so"
    snapshot_file "$CR_DIR/cloud_redirect_cli" "cr_cli"
    snapshot_file "$wrapper" "wrapper"
    snapshot_file "$ENV_CONF" "env_conf"
    DESKTOP_TX_PATHS=("${dr_user[@]}")
    for k in "${!dr_user[@]}"; do
        snapshot_file "${dr_user[k]}" "desktop.$k"
    done
    snapshot_roots

    # --- Phase 2: atomic commit + byte-exact verification ------------------
    TX_ACTIVE=1

    if [ "$stage_sls" = 1 ]; then
        atomic_copy_preserve "$STAGE_DIR/SLSsteam.so" "$SLS_DIR/SLSsteam.so" || die "cannot restore SLSsteam.so"
        cmp -s "$SLS_DIR/SLSsteam.so" "$SLS_DIR/SLSsteam.so.32" || die "SLSsteam.so byte-exact check failed"
        [ "$(elfbits "$SLS_DIR/SLSsteam.so")" = 32 ] || die "SLSsteam.so is not 32-bit after restore"
    fi
    if [ "$stage_cr" = 1 ]; then
        atomic_copy_preserve "$STAGE_DIR/cloud_redirect.so" "$CR_DIR/cloud_redirect.so" || die "cannot restore cloud_redirect.so"
        cmp -s "$CR_DIR/cloud_redirect.so" "$CR_DIR/cloud_redirect.so.32" || die "cloud_redirect.so byte-exact check failed"
        [ "$(elfbits "$CR_DIR/cloud_redirect.so")" = 32 ] || die "cloud_redirect.so is not 32-bit after restore"
    fi
    if [ "$stage_cr_cli" = 1 ]; then
        atomic_copy_preserve "$STAGE_DIR/cloud_redirect_cli" "$CR_DIR/cloud_redirect_cli" || die "cannot restore cloud_redirect_cli"
        cmp -s "$CR_DIR/cloud_redirect_cli" "$CR_DIR/cloud_redirect_cli.32" || die "cloud_redirect_cli byte-exact check failed"
        [ "$(elfbits "$CR_DIR/cloud_redirect_cli")" = 32 ] || die "cloud_redirect_cli is not 32-bit after restore"
    fi
    if [ "$stage_wrap" = 1 ]; then
        atomic_copy_preserve "$STAGE_DIR/wrapper" "$wrapper" || die "cannot restore wrapper"
        cmp -s "$wrapper" "$wrapper_bak" || die "wrapper byte-exact check failed"
    fi
    case "$env_action" in
        restore)
            atomic_copy_preserve "$STAGE_DIR/steam-32bit.conf" "$ENV_CONF" || die "cannot restore $ENV_CONF"
            cmp -s "$ENV_CONF" "$env_saved" || die "$ENV_CONF byte-exact check failed"
            sync_systemd_env "$(env_conf_value)"
            ;;
        remove)
            rm -f "$ENV_CONF" || die "cannot remove $ENV_CONF"
            sync_systemd_env ""
            ;;
        fallback)
            atomic_install 644 "$STAGE_DIR/steam-32bit.conf" "$ENV_CONF" || die "cannot reset $ENV_CONF"
            sync_systemd_env "ubuntu12_32"
            ;;
    esac
    for k in "${!dr_user[@]}"; do
        case "${dr_mode[k]}" in
            restore)
                atomic_copy_preserve "$STAGE_DIR/desktop.$k" "${dr_user[k]}" || die "cannot restore ${dr_user[k]}"
                cmp -s "${dr_user[k]}" "${dr_user[k]}.moon64-bak" || die "${dr_user[k]} byte-exact check failed"
                ;;
            remove)
                rm -f "${dr_user[k]}" || die "cannot remove ${dr_user[k]}"
                ;;
        esac
    done

    disable_64bit_client || die "cannot restore 32-bit client markers"
    tx_commit_done
    for k in "${!dr_user[@]}"; do
        rm -f "${dr_user[k]}.moon64-bak" "${dr_user[k]}.moon64-created"
    done

    if [ "$stage_sls" = 1 ]; then
        ok "SLSsteam.so: 32-bit restored (byte-exact)"
    else
        warn "no saved 32-bit SLSsteam.so; left as is"
    fi
    if [ "$stage_cr" = 1 ]; then
        ok "CloudRedirect: 32-bit restored (byte-exact)"
    elif [ "$(elfbits "$CR_DIR/cloud_redirect.so")" = 64 ]; then
        warn "cloud_redirect.so is 64-bit with no .32 backup; rebuild/reinstall 32-bit CloudRedirect"
    fi
    if [ "$stage_wrap" = 1 ]; then
        ok "wrapper: $wrapper (restored byte-exact to 32-bit stack)"
    else
        warn "no saved 32-bit wrapper at $wrapper_bak; launcher left as is"
    fi
    case "$env_action" in
        restore)  ok "environment.d: $ENV_CONF restored (byte-exact)" ;;
        remove)   ok "environment.d: $ENV_CONF removed (was absent before 'moon64 on')" ;;
        fallback) ok "environment.d: $ENV_CONF reset to STEAM_FORCE_CLIENT=ubuntu12_32" ;;
    esac
    for k in "${!dr_user[@]}"; do
        case "${dr_mode[k]}" in
            restore)
                ok "desktop entry: ${dr_user[k]} restored (byte-exact)"
                ;;
            remove)
                ok "desktop entry: removed the moon64 override ${dr_user[k]}"
                system_desktop_file "${dr_user[k]##*/}" >/dev/null \
                    || warn "Steam's own ${dr_user[k]##*/} is gone as well; no Steam desktop entry remains"
                ;;
        esac
    done
    printf '\n'
    ok "32-bit stack active — start Steam from your normal launcher"
}

cmd_status() {
    local on=0 r env_val
    printf '%s\n' "-- client --"
    for r in "${STEAM_ROOTS[@]}"; do
        [ -d "$r" ] || continue
        [ -e "$r/.steam-enable-steamrt64-client" ] && { on=1; dim "${r#"$HOME"/}: steamrt64 enabled"; }
        [ -e "$r/.steam-disable-steamrt64-client" ] && dim "${r#"$HOME"/}: steamrt64 disabled"
    done
    if [ "$on" = 1 ]; then
        ok "64-bit client selected"
    else
        ok "32-bit client selected"
    fi

    env_val="$(env_conf_value)"
    if [ -n "$env_val" ]; then
        dim "environment.d: STEAM_FORCE_CLIENT=$env_val (${ENV_CONF#"$HOME"/})"
    elif [ -f "$ENV_CONF" ]; then
        dim "environment.d: present without STEAM_FORCE_CLIENT (${ENV_CONF#"$HOME"/})"
    else
        dim "environment.d: ${ENV_CONF#"$HOME"/} absent"
    fi
    if [ -n "${STEAM_FORCE_CLIENT:-}" ]; then
        if { [ "$on" = 1 ] && [ "$STEAM_FORCE_CLIENT" != "steamrt64" ]; } \
           || { [ "$on" = 0 ] && [ "$STEAM_FORCE_CLIENT" = "steamrt64" ]; }; then
            warn "current shell exports STEAM_FORCE_CLIENT=$STEAM_FORCE_CLIENT"
        fi
    fi

    printf '%s\n' "-- active libraries --"
    local pair name active staged bits
    for pair in "$SLS_DIR/SLSsteam.so:$MOON_DIR/SLSsteam.so.64" \
                "$CR_DIR/cloud_redirect.so:$CR_DIR/cloud_redirect.so.64" \
                "$CR_DIR/cloud_redirect_cli:$CR_DIR/cloud_redirect_cli.64" \
                "$MOON_DIR/netsock64.so:"; do
        active="${pair%%:*}"; staged="${pair#*:}"
        name="$(basename "$active")"
        bits="$(elfbits "$active")"
        if [ -n "$bits" ]; then
            dim "$name: ${bits}-bit active$( [ -n "$staged" ] && [ -f "$staged" ] && printf ', 64-bit staged' )"
        else
            dim "$name: missing"
        fi
    done

    printf '%s\n' "-- steam --"
    if steam_running; then
        ok "running (pid $(cat "$HOME/.steam/steam.pid" 2>/dev/null))"
    else
        ok "not running"
    fi
}

check_slssteam_runtime_deps() {
    local so="$1" needed ldd_out dep missing_libs=""
    command -v readelf >/dev/null 2>&1 && command -v ldd >/dev/null 2>&1 || return 0
    needed="$(LC_ALL=C readelf -d "$so" 2>/dev/null \
        | sed -n 's/.*(NEEDED).*Shared library: \[\([^]]*\)\].*/\1/p')"
    ldd_out="$(LC_ALL=C env -u LD_LIBRARY_PATH -u LD_AUDIT -u LD_PRELOAD ldd -r "$so" 2>&1 || true)"
    while IFS= read -r dep; do
        [ -n "$dep" ] || continue
        case "$dep" in ld-linux-*.so*) continue ;; esac
        if printf '%s\n' "$ldd_out" | awk -v d="$dep" '$1 == d && $2 == "=>" && $3 == "not" && $4 == "found" { f=1 } END { exit !f }' \
           || ! printf '%s\n' "$ldd_out" | awk -v d="$dep" '$1 == d && $2 == "=>" && $3 ~ /^\// { f=1 } END { exit !f }'; then
            missing_libs="${missing_libs:+$missing_libs, }$dep"
        fi
    done <<< "$needed"
    if [ -n "$missing_libs" ]; then
        case "$missing_libs" in
            *libdbus-1.so.3*)
                bad "SLSsteam.so missing host 64-bit dependency: $missing_libs (install 64-bit libdbus / dbus-libs / libdbus-1-3)"
                ;;
            *)
                bad "SLSsteam.so missing host 64-bit dependency: $missing_libs"
                ;;
        esac
        return 1
    fi
    if grep -qE 'undefined symbol|version .* not found' <<<"$ldd_out"; then
        case "$ldd_out" in
            *GLIBCXX_*'not found'*)
                bad "SLSsteam.so requires a newer libstdc++ (missing GLIBCXX_* version, e.g. GLIBCXX_3.4.32 / GCC 13+)"
                ;;
        esac
        bad "SLSsteam.so has unresolved symbols/versions on this host"
        return 1
    fi
    ok "SLSsteam.so runtime dependencies resolve on host"
    return 0
}


read_manifest_install_path() {
    local manifest="$1"
    if command -v python3 >/dev/null 2>&1; then
        python3 - "$manifest" <<'PY' 2>/dev/null || true
import json, sys
try:
    with open(sys.argv[1], "r", encoding="utf-8") as f:
        data = json.load(f)
    val = data.get("installPath", "")
    if isinstance(val, str):
        print(val)
except Exception:
    pass
PY
        return 0
    fi
    if command -v jq >/dev/null 2>&1; then
        jq -r '.installPath // empty' "$manifest" 2>/dev/null || true
        return 0
    fi
    sed -n 's/.*"installPath"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$manifest" 2>/dev/null \
        | head -n 1 | sed 's|\\\/|/|g' || true
}

# Read-only Proton diagnostic: never modifies files or blocks readiness exit code.
check_proton_state() {
    local pvars_raw pvar pvars="" conf conf_name line trimmed key val env_d_hits=0
    local fix_dir="$LUMEN_FIX_INSTALLS_DIR"
    local manifest appid install_path dll_file dll_count found_manifests=0

    printf '%s\n' "-- proton --"

    if [ "${WINEDLLOVERRIDES+x}" = "x" ]; then
        if [ -n "$WINEDLLOVERRIDES" ]; then
            dim "env: WINEDLLOVERRIDES=$WINEDLLOVERRIDES"
        else
            dim "env: WINEDLLOVERRIDES=\"\" (set, empty)"
        fi
    else
        dim "env: WINEDLLOVERRIDES unset"
    fi

    pvars_raw="$(compgen -e PROTON_ 2>/dev/null || true)"
    if [ -n "$pvars_raw" ]; then
        while IFS= read -r pvar; do
            [ -n "$pvar" ] || continue
            pvars="${pvars:+$pvars }$pvar=${!pvar}"
        done <<<"$pvars_raw"
    fi
    if [ -n "$pvars" ]; then
        dim "env: $pvars"
    else
        dim "env: no PROTON_* variables set"
    fi

    if [ -d "$ENV_D_DIR" ]; then
        for conf in "$ENV_D_DIR"/*.conf; do
            [ -f "$conf" ] || continue
            conf_name="${conf##*/}"
            while IFS= read -r line || [ -n "$line" ]; do
                line="${line%$'\r'}"
                trimmed="${line#"${line%%[![:space:]]*}"}"
                case "$trimmed" in
                    ''|'#'*) continue ;;
                    WINEDLLOVERRIDES=*|PROTON_*=*)
                        key="${trimmed%%=*}"
                        val="${trimmed#*=}"
                        dim "environment.d ($conf_name): $key=$val"
                        env_d_hits=$((env_d_hits + 1))
                        ;;
                esac
            done < "$conf"
        done
    fi
    if [ "$env_d_hits" -eq 0 ]; then
        dim "environment.d: no WINEDLLOVERRIDES or PROTON_* entries"
    fi

    if [ -d "$fix_dir" ]; then
        for manifest in "$fix_dir"/*/manifest.json; do
            [ -f "$manifest" ] || continue
            found_manifests=$((found_manifests + 1))
            appid="$(basename "$(dirname "$manifest")")"
            install_path="$(read_manifest_install_path "$manifest")"
            if [ -z "$install_path" ] || [ ! -d "$install_path" ]; then
                warn "app $appid: installPath absent on disk (${install_path:-unknown})"
                continue
            fi
            dll_file="$install_path/.slssteam_fix_dlls"
            if [ -f "$dll_file" ]; then
                dll_count=0
                while IFS= read -r line || [ -n "$line" ]; do
                    line="${line%$'\r'}"
                    trimmed="${line#"${line%%[![:space:]]*}"}"
                    [ -n "$trimmed" ] || continue
                    dll_count=$((dll_count + 1))
                done < "$dll_file"
                if [ "$dll_count" -eq 0 ]; then
                    ok "app $appid ($(basename "$install_path")): .slssteam_fix_dlls present (0 DLLs — no overrides needed)"
                else
                    ok "app $appid ($(basename "$install_path")): .slssteam_fix_dlls present ($dll_count DLL(s))"
                fi
            else
                warn "app $appid ($(basename "$install_path")): .slssteam_fix_dlls missing (Proton DLL overrides unrecorded)"
            fi
        done
    fi
    if [ "$found_manifests" -eq 0 ]; then
        dim "managed games: none recorded ($fix_dir)"
    fi
}
# check_desktop_entries <active SLSsteam bits> — report where the Steam desktop
# entries point. Returns the number of blocking problems: an entry `on` would
# refuse to rewrite, or one that bypasses the wrapper while 64-bit is active.
check_desktop_entries() {
    local active="$1" name f src state prog found=0 problems=0
    printf '%s\n' "-- desktop entry --"
    for name in "${STEAM_DESKTOP_NAMES[@]}"; do
        f="$APPS_DIR/$name"
        if [ -f "$f" ]; then
            src="$f"
        elif ! src="$(system_desktop_file "$name")"; then
            continue
        fi
        found=1
        state="$(desktop_entry_state "$src")"
        case "$state" in
            ours)
                ok "$src starts the wrapper ($SLS_WRAPPER)"
                ;;
            invalid)
                bad "$src: an Exec= line is not a recognisable Steam launch; 'moon64 on' will refuse to rewrite it"
                problems=$((problems + 1))
                ;;
            *)
                if [ "$state" = partial ]; then
                    prog="Steam directly from some of its actions"
                else
                    prog="${state#foreign }"
                fi
                if [ "$active" = 64 ]; then
                    bad "$src runs $prog, not the wrapper — a normal Steam launch skips the 64-bit stack; run 'moon64 on'"
                    problems=$((problems + 1))
                else
                    dim "$src runs $prog; 'moon64 on' points it at $SLS_WRAPPER"
                fi
                [ "$src" = "$f" ] || dim "  system entry: 'moon64 on' writes a user-level override to $f"
                ;;
        esac
        [ -f "$f.moon64-bak" ] && dim "  original saved as $f.moon64-bak ('moon64 off' restores it)"
        [ -e "$f.moon64-created" ] && dim "  user-level override created by moon64 ('moon64 off' removes it)"
    done
    [ "$found" = 1 ] || warn "no Steam desktop entry in $APPS_DIR or \$XDG_DATA_DIRS; start Steam with $SLS_WRAPPER"
    return "$problems"
}

cmd_doctor() {
    local problems=0 sls staged crbits dep_target="" env_val
    printf '%s\n' "-- 64-bit readiness --"
    if [ ! -x "$HOME/.local/share/Steam/steamrt64/steam" ]; then bad "steamrt64 client binary missing"; problems=$((problems+1)); else ok "steamrt64 client present"; fi
    if [ ! -f "$HOME/.local/share/Steam/steamrt64/steamclient.so" ]; then bad "steamrt64/steamclient.so missing"; problems=$((problems+1)); else ok "steamrt64/steamclient.so present"; fi

    sls="$(elfbits "$SLS_DIR/SLSsteam.so")"
    staged="$(elfbits "$MOON_DIR/SLSsteam.so.64")"
    if [ "$sls" = 64 ]; then
        ok "SLSsteam.so is 64-bit (active)"
        dep_target="$SLS_DIR/SLSsteam.so"
    elif [ "$staged" = 64 ]; then
        ok "SLSsteam.so 64-bit staged — run 'moon64 on'"
        dep_target="$MOON_DIR/SLSsteam.so.64"
    else
        bad "no 64-bit SLSsteam: active=${sls:-missing} staged=${staged:-missing}"; problems=$((problems+1))
    fi

    if [ -n "$dep_target" ]; then
        check_slssteam_runtime_deps "$dep_target" || problems=$((problems+1))
    fi

    if [ -f "$MOON_DIR/netsock64.so" ]; then
        ok "netsock64.so present"
    else
        warn "netsock64.so missing — the P2P cert patch would not be applied"
    fi

    crbits="$(elfbits "$CR_DIR/cloud_redirect.so")"
    if [ "$crbits" = 64 ]; then
        ok "CloudRedirect hook is 64-bit (active)"
    elif [ "$(elfbits "$CR_DIR/cloud_redirect.so.64")" = 64 ]; then
        warn "CloudRedirect 64-bit staged but not active"
    elif [ -n "$crbits" ]; then
        warn "CloudRedirect hook is ${crbits}-bit — cloud saves will be inactive on 64-bit"
    fi
    if [ -f "$CR_DIR/cloud_redirect.so.32.bak" ] || [ -f "$CR_DIR/cloud_redirect_cli.32.bak" ]; then
        warn "legacy .32.bak CloudRedirect backup present — 'moon64 on'/'off' will migrate it to .32"
    fi

    env_val="$(env_conf_value)"
    if [ "$sls" = 64 ] && [ -n "$env_val" ] && [ "$env_val" != "steamrt64" ]; then
        warn "$ENV_CONF sets STEAM_FORCE_CLIENT=$env_val while 64-bit SLSsteam is active — run 'moon64 on'"
    elif [ -n "$env_val" ]; then
        dim "environment.d: STEAM_FORCE_CLIENT=$env_val"
    fi

    check_desktop_entries "$sls" || problems=$((problems + $?))

    check_proton_state
    printf '%s\n' "-- known 64-bit limits --"
    dim "library-inject.so (the libcurl redirect shim) has no 64-bit build. The"
    dim "64-bit client loads libcurl from its own runtime, so it is not needed."
    dim "\$SLSDIR/lib32 (32-bit libcrypto workaround) is likewise dropped."

    if [ "$problems" = 0 ]; then ok "no blocking problems"; else bad "$problems blocking problem(s)"; fi
    return "$problems"
}

usage() {
    cat <<EOF
moon64 — 64-bit Steam client switcher for the Luna/LuaTools stack

  moon64 on          activate the 64-bit steamrt64 client + 64-bit libraries and
                     point the Steam desktop entry at the SLSsteam wrapper
  moon64 off         restore the 32-bit ubuntu12_32 stack and the desktop entry
  moon64 stop-steam  gracefully quit a running Steam client and wait for file release
  moon64 status      staged vs active components, and the selected client
  moon64 doctor      check whether the 64-bit path can work, and why not

install.sh stages everything; 'on' and 'off' only swap files already on disk.
EOF
}

case "${1:-}" in
    on)         cmd_on ;;
    off)        cmd_off ;;
    stop-steam) cmd_stop_steam ;;
    status)     cmd_status ;;
    doctor)     cmd_doctor ;;
    ''|-h|--help|help) usage ;;
    *) bad "unknown command: $1"; usage; exit 2 ;;
esac
