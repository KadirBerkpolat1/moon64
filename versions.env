# shellcheck shell=bash
# shellcheck disable=SC2034  # every value here is consumed by a sourcing script
# Pinned upstream sources for the 64-bit stack.
#
# moon64 builds SLSsteam from source instead of downloading a release binary:
# the release binary is AceSLS's, which carries 6 feature modules and 17
# patterns, while this stack needs the swwayps fork's 79 modules and 61
# patterns (LuaTools stplug-in, Lumen CEF-port contract, live appinfo
# provisioning, hot reload). Building the fork for x86_64 is the only way to
# keep those.

# x86_64 port of the swwayps fork (AGPL-3.0). Public; cloned anonymously over HTTPS.
SLS64_REPO="https://github.com/KadirBerkpolat1/slsteam-moon-x64.git"
SLS64_REF="main"

# Where the pinned checkout lives when it is not already next to this repo.
SLS64_CLONE_DIR="${HOME}/.local/share/moon64/src/slsteam-moon-x64"

# Prebuilt x86_64 SLSsteam.so for `install.sh --prebuilt` and get.sh (override
# with SLSM_PREBUILT_URL). pattern-status.txt is taken from the same directory
# and binds the library it was measured on (binary_sha256=); each <file>.sha256
# is verified when published; see RELEASING.md. The current release publishes
# no netsock64.so: install.sh builds the cert patch from patches/netsock64
# with gcc when it can, else the P2P cert patch stays inactive. A release that
# does carry netsock64.so is still accepted, bound by netsock64_sha256=.
SLS64_PREBUILT_URL="https://github.com/KadirBerkpolat1/slsteam-moon-x64/releases/latest/download/SLSsteam.so"

# CloudRedirect 64-bit build pin (used by bin/build-cloudredirect.sh).
CLOUD_REDIRECT_COMMIT="19da05507dc8294a744d74c04ba875d4ca3cf2f7"

# Lumen fork: the fixes menu (FreeTP + online-fix.me + the FakeAppId swap) is
# maintained here, not as loose patch files. Copying individual files out of a
# tree that has 24 commits on top of upstream meant the patch set silently fell
# behind (and could not install a file upstream did not have yet).
LUMEN_REPO="https://github.com/KadirBerkpolat1/lumen.git"
LUMEN_REF="main"
LUMEN_CLONE_DIR="${HOME}/.local/share/moon64/src/lumen"

# LuaTools plugin fork: the store header button is maintained here because
# it is CEF-page JavaScript, not Lumen Lua.
LUATOOLS_REPO="https://github.com/KadirBerkpolat1/luatools-moon.git"
LUATOOLS_REF="main"
LUATOOLS_CLONE_DIR="${HOME}/.local/share/moon64/src/luatools-moon"

# 32-bit rollback target, fetched by install.sh only when no 32-bit SLSsteam is
# installed, so `moon64 off` always has something to restore. Upstream AceSLS
# release 20261106120254 is the last whose bin/SLSsteam.so is ELF32 i386;
# 20261112130346 and later ship x86_64 only. SHA-256 is of the release asset
# (it matches the digest GitHub publishes for it).
SLS32_VERSION="20261106120254"
SLS32_URL="https://github.com/AceSLS/SLSsteam/releases/download/${SLS32_VERSION}/SLSsteam-Any-release.7z"
SLS32_SHA256="b122fc3bc42b994b494ebb9bc66305b021a993bb0b50094e4ab4dd91f46da38e"
SLS32_MEMBER="bin/SLSsteam.so"
